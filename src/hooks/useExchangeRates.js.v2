import { useState, useEffect, useCallback } from 'react';

const CURRENCIES = [
  'USD',
  'EUR',
  'GBP',
  'AUD',
  'SGD',
  'HKD',
  'JPY',
  'KRW',
  'MYR',
  'THB',
  'PHP',
  'CNY'
];

export function useExchangeRates() {
  const [rates, setRates] = useState(() => {
    try {
      const saved = localStorage.getItem('rates');
      return saved ? JSON.parse(saved) : {};
    } catch {
      return {};
    }
  });

  const [kmkRates, setKmkRates] = useState(() => {
    try {
      const saved = localStorage.getItem('kmkRates');
      return saved ? JSON.parse(saved) : {};
    } catch {
      return {};
    }
  });

  const [isOffline, setIsOffline] = useState(!navigator.onLine);
  const [isLoadingKmk, setIsLoadingKmk] = useState(false);

  const fetchRates = useCallback(async () => {
    //
    // 1. Kurs Live dari Frankfurter
    //
    try {
      const response = await fetch(
        `https://api.frankfurter.app/latest?from=USD&to=IDR,${CURRENCIES.join(',')}`
      );

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = await response.json();

      const processed = {
        USD: data.rates.IDR
      };

      CURRENCIES.forEach((currency) => {
        if (
          currency !== 'USD' &&
          data.rates[currency]
        ) {
          processed[currency] =
            (1 / data.rates[currency]) *
            data.rates.IDR;
        }
      });

      setRates(processed);
      localStorage.setItem(
        'rates',
        JSON.stringify(processed)
      );
    } catch (error) {
      console.error(
        'Live Rates Fail:',
        error
      );
    }

    //
    // 2. KMK dari Google Sheet (opsional)
    //
    setIsLoadingKmk(true);

    try {
      const googleSheetCsvUrl =
        'https://docs.google.com/spreadsheets/d/18SWBclZwQLvD57-JjMYDNVQ3tWGUuaQpJcAfEAd2XD8/export?format=csv&gid=0';

      const response = await fetch(
        `${googleSheetCsvUrl}&t=${Date.now()}`
      );

      if (!response.ok) {
        throw new Error(
          `Google Sheet HTTP ${response.status}`
        );
      }

      const csvText = await response.text();

      const newKmkRates = {};

      const regex =
        /\(([A-Z]{3})\)[^,;]*[;,\s]+["']?([0-9]{1,3}(?:\.[0-9]{3})*(?:,[0-9]+)?)/g;

      let match;

      while ((match = regex.exec(csvText)) !== null) {
        const iso = match[1];

        let valueStr = match[2]
          .replace(/\./g, '')
          .replace(/,/g, '.');

        let finalValue = parseFloat(valueStr);

        if (!isNaN(finalValue)) {
          if (iso === 'JPY') {
            finalValue = finalValue / 100;
          }

          newKmkRates[iso] = finalValue;
        }
      }

      if (
        Object.keys(newKmkRates).length > 0
      ) {
        setKmkRates(newKmkRates);

        localStorage.setItem(
          'kmkRates',
          JSON.stringify(newKmkRates)
        );
      }
    } catch (error) {
      console.error(
        'KMK Sync Error:',
        error
      );
    } finally {
      setIsLoadingKmk(false);
    }
  }, []);

  useEffect(() => {
    fetchRates();

    const handleOnline = () => {
      setIsOffline(false);
      fetchRates();
    };

    const handleOffline = () => {
      setIsOffline(true);
    };

    window.addEventListener(
      'online',
      handleOnline
    );
    window.addEventListener(
      'offline',
      handleOffline
    );

    return () => {
      window.removeEventListener(
        'online',
        handleOnline
      );
      window.removeEventListener(
        'offline',
        handleOffline
      );
    };
  }, [fetchRates]);

  return {
    rates,
    kmkRates,
    isOffline,
    isLoadingKmk,
    fetchRates,
    CURRENCIES
  };
}
